# 环境档案：dev（开发机）
#
# 用法（PowerShell）：
#   $env:PERF_ENV="dev"; python platform_cli.py run --label local-dev
# 或一键脚本：
#   scripts/run.ps1 -Profile dev -Task perf
#
# 纪律（与这个仓库其它部分一致，理由见 README「环境分层」）：
#   1) 档案里**只写"与默认不同"的变量**。默认值定义在代码里，
#      不在这里重复 —— 重复的那一份迟早会漂移。
#   2) 档案**不覆盖已经显式设置过的环境变量**。你在命令行上
#      `$env:PERF_SUT_N1_SUPPLIERS="8"` 的意图比档案的默认值更强。
#   3) 不设 PERF_ENV（或设成 off）时，平台行为与引入分层之前**逐字节一致**：
#      没有任何变量被读写，这也是 CI 里三个 job 保持不变的原因。

# 报告实现：agg = 聚合扇出（默认）；n1 = 每个供应商单查一次。
# dev 上默认走 agg，与不设档案时一致。
PERF_SUT_REPORT_MODE=agg

# N+1 探针每次请求要遍历的供应商上限。
PERF_SUT_N1_SUPPLIERS=40

# 被测服务的数据量。dev 用 20000 条 —— 与 README §1 表里
# 得出 7.81× 那组数字的量级一致。调小它会让 N+1 缺陷"看起来变轻"：
# 800 条时比值只有 2.08×，那是在玩具数据量上做性能判断。
PERF_SUT_ITEMS=20000

# 结果库：dev 用仓库根的 quality.db（与 .gitignore 的既有约定一致）。
QUALITY_DB=quality.db

# 被测服务自己的开发库。
PERF_SUT_DB=sut/sut.db
