# 运行产物 —— 这些不是源码
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
# `--cov-report=json:.coverage.json
# 本地手动跑 --cov-report=json:coverage.json 的产物（CI 里叫 .coverage.json）。
coverage.json` 的产物：per-file 门禁读它。
# 它是**产物**不是源码，每次跑测试都重新生成；误提交进去会让
# 「覆盖率到底多少」变成一份可能过期的快照，而门禁读它等于在判旧数据。
.coverage.*
.coverage.json
htmlcov/
coverage.xml

# 平台自己的结果库与生成的报告
quality.db
quality.db-wal
quality.db-shm
reports/*.md
# 导出的静态看板（是产物，不是源码；CI 会把它推到 gh-pages）
reports/dashboard/
# Pages job 从 gh-pages 取回来临时合并的历史库
.history/

# 被测服务的开发库（压测用的库一律落在临时目录，不会出现在这里）
sut/sut.db
sut/sut.db-wal
sut/sut.db-shm

# CI 日志抓取产物（诊断用，不是源码）
ci_logs/

# 各类工具缓存（都是可重建的产物，进仓库只会制造无意义的 diff）
.mypy_cache/
.ruff_cache/
.pip-tools-cache/
*.egg-info/
build/
dist/

# 本地覆写的环境变量（例如把自己的 PERF_ENV / QUALITY_DB 写在里面）。
# 注意：真正的环境档案在 scripts/envs/*.env，那些是**要入库**的，
# 不在本忽略范围内 —— 它们是要被审查的配置，不是个人偏好。
.env
